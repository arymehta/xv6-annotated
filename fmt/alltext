9101 parseblock(char **ps, char *es)
9102 {
9103   struct cmd *cmd;
9104 
9105   if(!peek(ps, es, "("))
9106     panic("parseblock");
9107   gettoken(ps, es, 0, 0);
9108   cmd = parseline(ps, es);
9109   if(!peek(ps, es, ")"))
9110     panic("syntax - missing )");
9111   gettoken(ps, es, 0, 0);
9112   cmd = parseredirs(cmd, ps, es);
9113   return cmd;
9114 }
