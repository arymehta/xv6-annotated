6660 	}
6661 	if (f->type == FD_NONE) {
6662 		cprintf("lseek: FD_NONE\n");
6663 		return -1;
6664 	}
6665 
6666 
6667 	int newOffset;
6668 	int currOffset = f->off;
6669 	switch(whence)
6670 	{
6671 		case SEEK_SET:
6672 			newOffset = 0 + offset;
6673 			break;
6674 		case SEEK_CUR:
6675 			newOffset = currOffset + offset;
6676 			break;
6677 		case SEEK_END:
6678 			newOffset = f->ip->size + offset;
6679 			break;
6680 		default:
6681 			cprintf("lseek: Bad whence value!\n");
6682 			return EINVAL;
6683 	}
6684 
6685 	if(newOffset < 0) {
6686 		cprintf("Negative Offset!\n");
6687 		return EINVAL;
6688 	}
6689 
6690 	else if(newOffset > f->ip->size) {
6691 		cprintf("lseek: Offset exceeds file size, assignment specified not to handle\n");
6692 		return EINVAL;
6693 	}
6694 
6695 	else f->off = newOffset;
6696 	return newOffset;
6697 }
