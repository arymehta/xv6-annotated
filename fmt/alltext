8668   switch(cmd->type){
8669   default:
8670     panic("runcmd");
8671 
8672   case EXEC:
8673     ecmd = (struct execcmd*)cmd;
8674     if(ecmd->argv[0] == 0)
8675       exit();
8676     exec(ecmd->argv[0], ecmd->argv);
8677     printf(2, "exec %s failed\n", ecmd->argv[0]);
