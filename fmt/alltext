6888         release(&p->lock);
6889         return -1;
6890       }
6891       wakeup(&p->nread);
6892       sleep(&p->nwrite, &p->lock);  
6893     }
6894     p->data[p->nwrite++ % PIPESIZE] = addr[i];
6895   }
6896   wakeup(&p->nread);  
6897   release(&p->lock);
6898   return n;
