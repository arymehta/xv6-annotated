4321   
4322   b->flags |= B_VALID;
4323   b->flags &= ~B_DIRTY;
4324   wakeup(b);
4325 
4326   
4327   if(idequeue != 0)
4328     idestart(idequeue);
4329 
4330   release(&idelock);
