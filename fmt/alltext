9000 int
9001 peek(char **ps, char *es, char *toks)
9002 {
9003   char *s;
9004 
9005   s = *ps;
9006   while(s < es && strchr(whitespace, *s))
9007     s++;
9008   *ps = s;
9009   return *s && strchr(toks, *s);
9010 }
