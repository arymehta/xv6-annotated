1837 pde_t*
1838 setupkvm(void)
1839 {
1840     /* Aryan
1841      * allocate one page from kmem.freelist and assign it to pgdir
1842      * typecast run* to char* (byte pointer), so can change individual bytes to 0
1843      * */
1844   pde_t *pgdir;
