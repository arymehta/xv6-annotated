8955 int
8956 gettoken(char **ps, char *es, char **q, char **eq)
8957 {
8958   char *s;
8959   int ret;
8960 
8961   s = *ps;
8962   while(s < es && strchr(whitespace, *s))
8963     s++;
8964   if(q)
8965     *q = s;
8966   ret = *s;
8967   switch(*s){
8968   case 0:
8969     break;
8970   case '|':
8971   case '(':
8972   case ')':
8973   case ';':
8974   case '&':
8975   case '<':
8976     s++;
8977     break;
8978   case '>':
8979     s++;
8980     if(*s == '>'){
8981       ret = '+';
8982       s++;
8983     }
8984     break;
8985   default:
8986     ret = 'a';
8987     while(s < es && !strchr(whitespace, *s) && !strchr(symbols, *s))
8988       s++;
8989     break;
8990   }
8991   if(eq)
8992     *eq = s;
8993 
8994   while(s < es && strchr(whitespace, *s))
8995     s++;
8996   *ps = s;
8997   return ret;
8998 }
