8973   es = s + strlen(s);
8974   cmd = parseline(&s, es);
8975   peek(&s, es, "");
8976   if(s != es){
8977     printf(2, "leftovers: %s\n", s);
8978     panic("syntax");
8979   }
8980   nulterminate(cmd);
8981   return cmd;
8982 }
