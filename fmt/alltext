6574 int sys_lseek(void)
6575 {
6576 	int fd;
6577 	int offset;
6578 	int whence;
6579 
6580 	if(argint(0, &fd) == -1) return -1;
6581 	if(argint(1, &offset) == -1) return -1;
6582 	if(argint(2, &whence) == -1) return -1;
6583 
6584 
6585 	if(fd == -1 || fd >= NOFILE){
6586 		cprintf("lseek: bad file descriptor!\n");
6587 		return EBADF;
6588 	}
6589 
6590 	struct file *f = myproc()->ofile[fd];
6591 	if(!f) return -1;
6592 	if(f->type == FD_PIPE) {
6593 		cprintf("lseek: Cannot lseek pipe inode!!\n");
6594 		return ESPIPE;
6595 	}
6596 	if (f->type == FD_NONE) {
6597 		cprintf("lseek: FD_NONE\n");
6598 		return -1;
6599 	}
6600 	int newOffset;
6601 	int currOffset = f->off;
6602 	switch(whence)
6603 	{
6604 		case SEEK_SET:
6605 			newOffset = 0 + offset;
6606 			break;
6607 		case SEEK_CUR:
6608 			newOffset = currOffset + offset;
6609 			break;
6610 		case SEEK_END:
6611 			newOffset = f->ip->size + offset;
6612 			break;
6613 		default:
6614 			cprintf("lseek: Bad whence value!\n");
6615 			return EINVAL;
6616 	}
6617 
6618 	if(newOffset < 0) {
6619 		cprintf("Negative Offset!\n");
6620 		return EINVAL;
6621 	}
6622 
6623 	else if(newOffset > f->ip->size) {
6624 		cprintf("lseek: Offset exceeds file size, assignment specified not to handle\n");
6625 	}
6626 
6627 	else f->off = newOffset;
6628 	return newOffset;
6629 }
